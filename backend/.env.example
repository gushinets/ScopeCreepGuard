# Native API/worker development. Compose settings belong in the root .env.
SCOPE_GUARD_LOG_LEVEL=INFO
SCOPE_GUARD_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SCOPE_GUARD_PRODUCTION=false
# AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# SCOPE_GUARD_DATABASE_URL=postgresql://scopeguard:local-password@localhost:5432/scope_creep_guard
# OPENAI_API_KEY=replace-locally
SCOPE_GUARD_OPENAI_MODEL=gpt-6-luna
# Set bounds and workflow flags for native persistent/LLM workflow development.
SCOPE_GUARD_WORKFLOW_V2=false
SCOPE_GUARD_LLM_WORKFLOW=false
# SCOPE_GUARD_LLM_INPUT_RATE_BOUND=your-conservative-USD-per-token-bound
# SCOPE_GUARD_LLM_OUTPUT_RATE_BOUND=your-conservative-USD-per-token-bound
SCOPE_GUARD_LLM_MAX_COST=1.00
# SCOPE_GUARD_EXPORT_BUCKET=private-scopeguard-exports
# SCOPE_GUARD_EXPORT_ENDPOINT=https://your-private-s3-endpoint
SCOPE_GUARD_EXPORT_REGION=us-east-1
# SCOPE_GUARD_EXPORT_ACCESS_KEY=replace-locally
# SCOPE_GUARD_EXPORT_SECRET_KEY=replace-locally
# Explicit reviewed legacy adoption belongs to the migration runner, never API startup.
# SCOPE_GUARD_ADOPT_LEGACY=true
SCOPE_GUARD_MIGRATION_LOCK_TIMEOUT_SECONDS=120

# Standalone API trusts no forwarding proxy. Compose sets ["app"].
SCOPE_GUARD_TRUSTED_PROXY_HOSTS=[]
