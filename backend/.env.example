# Optional: the backend starts with no external integration settings.
SCOPE_GUARD_LOG_LEVEL=INFO
# Match the frontend's explicitly configured public origins; no wildcard CORS.
SCOPE_GUARD_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional database connectivity readiness; startup/liveness also work when unset.
# Authentication requires the same raw AUTH_SECRET as the frontend session verifier.
# AUTH_SECRET=replace-with-the-shared-secret
# Native development defaults to non-Secure cookies; production images enable Secure.
SCOPE_GUARD_PRODUCTION=false
# SCOPE_GUARD_DATABASE_URL=postgresql://scopeguard:local-password@localhost:5432/scope_creep_guard
