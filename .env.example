# Root configuration is for Compose. Local Next.js/Drizzle use frontend/.env*.
# Compose overrides DATABASE_URL to the internal postgres host in local containers.
DATABASE_URL=postgres://scopeguard:scopeguard_dev_password@localhost:5432/scope_creep_guard
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
OPENAI_API_KEY=replace-with-your-openai-api-key

POSTGRES_PORT=5432
FRONTEND_PORT=3000
BACKEND_PORT=8000
SCOPE_GUARD_LOG_LEVEL=INFO
