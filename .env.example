# Compose interpolation: shell > explicit --env-file (or root .env).
# Keep the existing project name when upgrading an installation.
# COMPOSE_PROJECT_NAME=scopecreepguard
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
OPENAI_API_KEY=replace-with-your-openai-api-key
SCOPE_GUARD_OPENAI_MODEL=gpt-6-luna
# Required conservative USD per TOKEN bounds: replace with your model's values.
SCOPE_GUARD_LLM_INPUT_RATE_BOUND=
SCOPE_GUARD_LLM_OUTPUT_RATE_BOUND=
SCOPE_GUARD_LLM_MAX_COST=1.00
# Existing local PostgreSQL defaults; URL must match credentials if changed.
SCOPE_GUARD_DATABASE_URL=postgres://scopeguard:scopeguard_dev_password@postgres:5432/scope_creep_guard
POSTGRES_DB=scope_creep_guard
POSTGRES_USER=scopeguard
POSTGRES_PASSWORD=scopeguard_dev_password
# Dokploy additionally requires DATABASE_URL matching its database credentials.
# DATABASE_URL=postgres://scopeguard:replace-password@postgres:5432/scope_creep_guard
SCOPE_GUARD_EXPORT_BUCKET=
SCOPE_GUARD_EXPORT_ENDPOINT=
SCOPE_GUARD_EXPORT_REGION=us-east-1
SCOPE_GUARD_EXPORT_ACCESS_KEY=
SCOPE_GUARD_EXPORT_SECRET_KEY=
# Dokploy provisions private Silo storage with separate administrator credentials.
# SCOPE_GUARD_EXPORT_ENDPOINT=http://silo:9000
# SCOPE_GUARD_SILO_ROOT_USER=
# SCOPE_GUARD_SILO_ROOT_PASSWORD=
# Include silo in NO_PROXY so private exports bypass the outbound proxy.
POSTGRES_PORT=5432
FRONTEND_PORT=3000
BACKEND_PORT=8000
SCOPE_GUARD_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Local HTTP only. Dokploy forces true and requires an explicit HTTPS allowlist.
SCOPE_GUARD_PRODUCTION=false
SCOPE_GUARD_LOG_LEVEL=INFO
SCOPE_GUARD_ADOPT_LEGACY=false
SCOPE_GUARD_MIGRATION_LOCK_TIMEOUT_SECONDS=120
# Optional immutable release references for published-image startup/update --pull.
# SCOPE_GUARD_API_IMAGE=registry.example/scg-api@sha256:...
# SCOPE_GUARD_WORKER_IMAGE=registry.example/scg-worker@sha256:...
# SCOPE_GUARD_FRONTEND_IMAGE=registry.example/scg-frontend@sha256:...
# Set to git rev-parse HEAD before building; a dirty checkout needs a separate record.
# SOURCE_REVISION=...
# For a reviewed nonstandard EXISTING database volume only; set both together.
# external=true fails if the named volume does not exist.
# SCOPE_GUARD_POSTGRES_VOLUME=existing-database-volume
# SCOPE_GUARD_POSTGRES_VOLUME_EXTERNAL=true

# Local Mailpit web UI (loopback only); SMTP stays internal at mailpit:1025.
MAILPIT_UI_PORT=8025

# ANY-779: local capture identity only; not approved for production.
SCOPE_GUARD_SMTP_HOST=mailpit
SCOPE_GUARD_SMTP_PORT=1025
SCOPE_GUARD_SMTP_SENDER_ADDRESS=no-reply-scopecreepguard@mail.com
SCOPE_GUARD_SMTP_SENDER_NAME=ScopeCreepGuard
SCOPE_GUARD_SMTP_TRANSPORT=none
SCOPE_GUARD_SMTP_TIMEOUT=10
SCOPE_GUARD_SMTP_DEADLINE=30
# Optional paired credentials; omit both for Mailpit.
# SCOPE_GUARD_SMTP_USERNAME=
# SCOPE_GUARD_SMTP_PASSWORD=
