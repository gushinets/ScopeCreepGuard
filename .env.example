# Root configuration is for Compose. PostgreSQL credentials are provided only to
# the API container, including its guarded Alembic entrypoint.
DATABASE_URL=postgres://scopeguard:scopeguard_dev_password@localhost:5432/scope_creep_guard
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
OPENAI_API_KEY=replace-with-your-openai-api-key
# Optional model override; OPENAI_MODEL is also accepted as a compatibility alias.
SCOPE_GUARD_OPENAI_MODEL=gpt-5.6-luna

POSTGRES_PORT=5432
FRONTEND_PORT=3000
BACKEND_PORT=8000
SCOPE_GUARD_LOG_LEVEL=INFO
SCOPE_GUARD_ADOPT_LEGACY=false
