# Next.js reads configuration from frontend/.env* or process variables.
# PostgreSQL configuration belongs only to the backend and migration job.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Configure OPENAI_API_KEY only in backend/.env or the backend process.
# Exact public browser origins; JSON array. Supplied unknown Origins are rejected.
SCOPE_GUARD_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Backend API origin; never NEXT_PUBLIC_.
SCOPE_GUARD_API_ORIGIN=http://127.0.0.1:8000
