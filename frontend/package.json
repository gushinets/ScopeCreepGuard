    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "next-intl": "^4.13.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "postgres": "^3.4.9",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
