    "docker:down": "docker compose -f ../compose.yaml --profile app down"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/analytics": "1.6.1",
